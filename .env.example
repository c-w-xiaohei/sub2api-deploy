# Pulumi config is authoritative. This file is documentation only and is not
# loaded automatically by the deployment program.
RESOURCE_NAMESPACE=sub2api
DOMAIN=sub2api.example.com
ORIGIN_IP=203.0.113.10
POSTGRES_MODE=docker
REDIS_MODE=docker
SUB2API_IMAGE=weishaw/sub2api@sha256:REPLACE_WITH_IMMUTABLE_DIGEST
TRAEFIK_IMAGE=traefik:v3.3.3
ACME_EMAIL=ops@example.com
APP_PROBE_PATH=/api/ready

# Configure with `pulumi config set --secret ...`, not in this file.
# postgresPassword / neonDsn / neonPassword / neonApiToken
# redisPassword / upstashPassword / upstashApiKey
# adminPassword / jwtSecret / totpEncryptionKey / cloudflareApiToken
